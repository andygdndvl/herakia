# Formulaire de contact — envoi via Resend (https://resend.com)
# Copier ce fichier en .env.local et renseigner les valeurs.

# Clé API Resend (obligatoire pour l'envoi réel)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les leads (défaut : contact@herakia.com)
CONTACT_TO_EMAIL=contact@herakia.com

# Expéditeur — DOIT être sur un domaine vérifié chez Resend.
# Avant vérification du domaine herakia.com, utiliser : Herakia <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Herakia <contact@herakia.com>
