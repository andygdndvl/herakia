datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model ContactSubmission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  company   String?
  message   String
  read      Boolean  @default(false)
  emailSent Boolean  @default(false)
}